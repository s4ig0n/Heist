# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol

# Heist attack runs. Sandbox only: runs refuse unless PAYPAL_ENVIRONMENT is exactly SANDBOX.
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
# Required to start a run in production. Sent as "Authorization: Bearer <token>".
HEIST_RUN_TOKEN=
# Optional. Runs a day per server process. Defaults to 10.
HEIST_MAX_RUNS_PER_DAY=
# Optional.
NIMBUS_MODEL=
ATTACKER_MODEL=
